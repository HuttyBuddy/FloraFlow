<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <!-- Header with Logo/Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_logo_heart" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="FloraFlow"
            android:textColor="#FF1F483E"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Streak Status -->
    <TextView
        android:id="@+id/widget_streak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔥 0 Day Streak"
        android:textColor="#FF1F483E"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Next Care Task -->
    <TextView
        android:id="@+id/widget_next_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Next: No tasks due today!"
        android:textColor="#FF43493E"
        android:textSize="12sp"
        android:ellipsize="end"
        android:singleLine="true"
        android:layout_marginBottom="4dp" />

    <!-- Neural Load score -->
    <TextView
        android:id="@+id/widget_neural_load"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Neural Load: --"
        android:textColor="#FF1F483E"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Next steps progress -->
    <TextView
        android:id="@+id/widget_steps_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Next Steps: 0/3 Completed"
        android:textColor="#FF43493E"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <!-- Weather Info -->
    <TextView
        android:id="@+id/widget_weather"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Weather: ☀️ Clear 68°F"
        android:textColor="#FF43493E"
        android:textSize="11sp" />
</LinearLayout>
