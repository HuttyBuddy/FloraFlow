# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY
# GEMINI_PROXY_URL: host only, no scheme or trailing slash, e.g.
# "my-proxy-abc123.run.app". Leave as YOUR_PROXY_URL to call Gemini directly
# with GEMINI_API_KEY instead (fine for local dev, not for a public release).
GEMINI_PROXY_URL=YOUR_PROXY_URL
# APP_SHARED_SECRET: must match the proxy's APP_SHARED_SECRET env var
# (see gemini-proxy/index.js). Sent as the X-App-Secret header on every
# proxied request so the proxy can reject traffic that isn't from this app.
APP_SHARED_SECRET=YOUR_APP_SHARED_SECRET
